{% liquid
  assign section_link = section.settings.link
%}

<section
  class="promo-gradient-banner section-{{ section.id }}"
  {% if section.settings.bg_image != blank %}
    style="--promo-bg-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="promo-gradient-banner__wrap page-width">
    {% if section_link != blank %}
      <a href="{{ section_link }}" class="promo-gradient-banner__inner promo-gradient-banner__inner--link">
    {% else %}
      <div class="promo-gradient-banner__inner">
    {% endif %}

        <div class="promo-gradient-banner__content">
          {% if section.settings.discount_text != blank %}
            <div class="promo-gradient-banner__discount">
              {{ section.settings.discount_text }}
            </div>
          {% endif %}

          <div class="promo-gradient-banner__text-group">
            {% if section.settings.heading != blank %}
              <h2 class="promo-gradient-banner__heading">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            {% if section.settings.subheading != blank %}
              <div class="promo-gradient-banner__subheading">
                {{ section.settings.subheading }}
              </div>
            {% endif %}
          </div>
        </div>

        {% if section.settings.show_arrow %}
          <span class="promo-gradient-banner__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {% endif %}

        <span class="promo-gradient-banner__stripes" aria-hidden="true"></span>

    {% if section_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --promo-border-radius: {{ section.settings.border_radius }}px;
    --promo-padding-y: {{ section.settings.padding_y }}px;
    --promo-padding-x: {{ section.settings.padding_x }}px;
    --promo-discount-size: {{ section.settings.discount_size }}px;
    --promo-heading-size: {{ section.settings.heading_size }}px;
    --promo-subheading-size: {{ section.settings.subheading_size }}px;
    --promo-min-height: {{ section.settings.banner_height }}px;
    --promo-text-color: {{ section.settings.text_color }};
    --promo-arrow-bg: {{ section.settings.arrow_bg }};
    --promo-arrow-color: {{ section.settings.arrow_color }};
    --promo-gradient-1: {{ section.settings.gradient_1 }};
    --promo-gradient-2: {{ section.settings.gradient_2 }};
    --promo-gradient-3: {{ section.settings.gradient_3 }};
    --promo-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .section-{{ section.id }} .promo-gradient-banner__wrap {
    width: 100%;
  }

  .section-{{ section.id }} .promo-gradient-banner__inner,
  .section-{{ section.id }} .promo-gradient-banner__inner--link {
    position: relative;
    overflow: hidden;
    min-height: var(--promo-min-height);
    border-radius: var(--promo-border-radius);
    padding: var(--promo-padding-y) var(--promo-padding-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--promo-text-color);
    text-decoration: none;
    box-shadow: var(--promo-shadow);
    background:
      linear-gradient(135deg, var(--promo-gradient-1), var(--promo-gradient-2) 60%, var(--promo-gradient-3));
    isolation: isolate;
  }

  .section-{{ section.id }} .promo-gradient-banner__inner::before,
  .section-{{ section.id }} .promo-gradient-banner__inner--link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--promo-bg-image);
    background-size: cover;
    background-position: center;
    opacity: {% if section.settings.bg_image != blank %}0.14{% else %}0{% endif %};
  }

  .section-{{ section.id }} .promo-gradient-banner__content {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1 1 auto;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .section-{{ section.id }} .promo-gradient-banner__discount {
    font-size: var(--promo-discount-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .section-{{ section.id }} .promo-gradient-banner__text-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .section-{{ section.id }} .promo-gradient-banner__heading {
    margin: 0;
    font-size: var(--promo-heading-size);
    line-height: 1.2;
    font-weight: 700;
    color: inherit;
  }

  .section-{{ section.id }} .promo-gradient-banner__subheading {
    font-size: var(--promo-subheading-size);
    line-height: 1.4;
    opacity: 0.92;
  }

  .section-{{ section.id }} .promo-gradient-banner__arrow {
    position: relative;
    z-index: 2;
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 16px;
    background: var(--promo-arrow-bg);
    color: var(--promo-arrow-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
    transition: transform 0.25s ease;
  }

  .section-{{ section.id }} .promo-gradient-banner__arrow svg {
    width: 24px;
    height: 24px;
  }

  .section-{{ section.id }} .promo-gradient-banner__inner--link:hover .promo-gradient-banner__arrow {
    transform: translateX(3px);
  }

  .section-{{ section.id }} .promo-gradient-banner__stripes {
    position: absolute;
    top: -8%;
    right: 72px;
    width: 180px;
    height: 180%;
    z-index: 1;
    pointer-events: none;
    transform: skewX(-18deg);
    opacity: 0.18;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255,255,255,0.95) 0 8px,
        transparent 8px 20px
      );
  }

  @media (max-width: 989px) {
    .section-{{ section.id }} .promo-gradient-banner__inner,
    .section-{{ section.id }} .promo-gradient-banner__inner--link {
      padding: 22px 24px;
      min-height: auto;
    }

    .section-{{ section.id }} .promo-gradient-banner__content {
      gap: 18px;
    }

    .section-{{ section.id }} .promo-gradient-banner__discount {
      font-size: calc(var(--promo-discount-size) * 0.78);
    }

    .section-{{ section.id }} .promo-gradient-banner__heading {
      font-size: calc(var(--promo-heading-size) * 0.9);
    }

    .section-{{ section.id }} .promo-gradient-banner__subheading {
      font-size: calc(var(--promo-subheading-size) * 0.95);
    }

    .section-{{ section.id }} .promo-gradient-banner__arrow {
      width: 50px;
      height: 50px;
      min-width: 50px;
    }

    .section-{{ section.id }} .promo-gradient-banner__stripes {
      right: 55px;
      width: 130px;
    }
  }

  @media (max-width: 749px) {
    .section-{{ section.id }} .promo-gradient-banner__inner,
    .section-{{ section.id }} .promo-gradient-banner__inner--link {
      padding: 18px 18px;
      gap: 14px;
      border-radius: calc(var(--promo-border-radius) - 6px);
    }

    .section-{{ section.id }} .promo-gradient-banner__content {
      gap: 14px;
    }

    .section-{{ section.id }} .promo-gradient-banner__discount {
      font-size: calc(var(--promo-discount-size) * 0.62);
    }

    .section-{{ section.id }} .promo-gradient-banner__heading {
      font-size: calc(var(--promo-heading-size) * 0.78);
    }

    .section-{{ section.id }} .promo-gradient-banner__subheading {
      font-size: calc(var(--promo-subheading-size) * 0.9);
    }

    .section-{{ section.id }} .promo-gradient-banner__arrow {
      width: 44px;
      height: 44px;
      min-width: 44px;
      border-radius: 12px;
    }

    .section-{{ section.id }} .promo-gradient-banner__stripes {
      right: 42px;
      width: 90px;
      opacity: 0.12;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.promo-gradient-banner.name",
  "tag": "section",
  "class": "section section-promo-gradient-banner",
  "settings": [
    {
      "type": "text",
      "id": "discount_text",
      "label": "t:sections.promo-gradient-banner.settings.discount_text.label",
      "default": "30%"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.promo-gradient-banner.settings.heading.label",
      "default": "Fresh groceries"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.promo-gradient-banner.settings.subheading.label",
      "default": "big savings daily"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.promo-gradient-banner.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "t:sections.promo-gradient-banner.settings.show_arrow.label",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:sections.promo-gradient-banner.settings.bg_image.label"
    },

    {
      "type": "header",
      "content": "t:sections.promo-gradient-banner.settings.colors.header"
    },
    {
      "type": "color",
      "id": "gradient_1",
      "label": "t:sections.promo-gradient-banner.settings.gradient_1.label",
      "default": "#0aa89e"
    },
    {
      "type": "color",
      "id": "gradient_2",
      "label": "t:sections.promo-gradient-banner.settings.gradient_2.label",
      "default": "#12c85f"
    },
    {
      "type": "color",
      "id": "gradient_3",
      "label": "t:sections.promo-gradient-banner.settings.gradient_3.label",
      "default": "#26dd6f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.promo-gradient-banner.settings.text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "t:sections.promo-gradient-banner.settings.arrow_bg.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "t:sections.promo-gradient-banner.settings.arrow_color.label",
      "default": "#0f8f6a"
    },

    {
      "type": "header",
      "content": "t:sections.promo-gradient-banner.settings.spacing.header"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "t:sections.promo-gradient-banner.settings.banner_height.label",
      "min": 80,
      "max": 220,
      "step": 2,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "t:sections.promo-gradient-banner.settings.padding_y.label",
      "min": 12,
      "max": 50,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "t:sections.promo-gradient-banner.settings.padding_x.label",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:sections.promo-gradient-banner.settings.border_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "t:sections.promo-gradient-banner.settings.typography.header"
    },
    {
      "type": "range",
      "id": "discount_size",
      "label": "t:sections.promo-gradient-banner.settings.discount_size.label",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:sections.promo-gradient-banner.settings.heading_size.label",
      "min": 16,
      "max": 40,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "t:sections.promo-gradient-banner.settings.subheading_size.label",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo-gradient-banner.presets.name"
    }
  ]
}
{% endschema %}