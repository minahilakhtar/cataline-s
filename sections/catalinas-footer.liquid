{% liquid
  assign explore_menu = section.settings.explore_menu
  assign helpful_menu = section.settings.helpful_menu
  assign story_url = section.settings.story_url | default: '/pages/about-us'
  assign contact_url = section.settings.contact_url | default: '/pages/contact'
  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
  assign facebook_url = section.settings.facebook_url | default: settings.social_facebook_link
  assign linkedin_url = section.settings.linkedin_url
%}

<footer id="cf-footer-{{ section.id }}" class="cff" aria-label="Site footer">
  <div class="cff-columns">
    <div class="cff-brand">
      <a
        href="{{ routes.root_url }}"
        class="cff-logo"
        aria-label="{{ shop.name | escape }} — home"
      >
        <img
          src="{{ 'logo-white.png' | asset_url }}"
          width="300"
          loading="lazy"
          alt="{{ shop.name | escape }}"
        >
      </a>
    </div>

    <nav class="cff-nav" aria-labelledby="cff-explore-{{ section.id }}">
      <h2 id="cff-explore-{{ section.id }}">Explore</h2>

      {% if explore_menu != blank %}
        {% for link in explore_menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ story_url }}">Our Story</a>
        <a href="{{ routes.all_products_collection_url }}">Products</a>
        <a href="{{ contact_url }}">Contact</a>
      {% endif %}
    </nav>

    <nav class="cff-nav" aria-labelledby="cff-helpful-{{ section.id }}">
      <h2 id="cff-helpful-{{ section.id }}">Helpful links</h2>

      {% if helpful_menu != blank %}
        {% for link in helpful_menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        {% if shop.privacy_policy != blank %}
          <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>
        {% endif %}

        {% if shop.refund_policy != blank %}
          <a href="{{ shop.refund_policy.url }}">Refund Policy</a>
        {% endif %}

        {% if shop.shipping_policy != blank %}
          <a href="{{ shop.shipping_policy.url }}">Shipping Policy</a>
        {% endif %}

        {% if shop.terms_of_service != blank %}
          <a href="{{ shop.terms_of_service.url }}">Terms of Service</a>
        {% endif %}
      {% endif %}
    </nav>

    <div class="cff-social">
      {% if instagram_url != blank %}
        <a
          href="{{ instagram_url | escape }}"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r=".8" class="cff-social-dot"/>
          </svg>
        </a>
      {% endif %}

      {% if facebook_url != blank %}
        <a
          href="{{ facebook_url | escape }}"
          aria-label="Facebook"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              class="cff-social-fill"
              d="M13.5 22v-9h3l.5-3.5h-3.5V7.25c0-1.01.28-1.7 1.73-1.7H17V2.42A23.7 23.7 0 0 0 14.42 2C11.87 2 10 3.55 10 6.4v3.1H7V13h3v9h3.5Z"
            />
          </svg>
        </a>
      {% endif %}

      {% if linkedin_url != blank %}
        <a
          href="{{ linkedin_url | escape }}"
          aria-label="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M7.5 10v7M11.5 17v-7M11.5 13a3 3 0 0 1 6 0v4"/>
            <circle cx="7.5" cy="7" r=".8" class="cff-social-dot"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.photo_credits_url != blank %}
    <div class="cff-credits">
      <a href="{{ section.settings.photo_credits_url }}">Photo credits</a>
    </div>
  {% endif %}

  <div class="cff-bottom">
    © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
  </div>
</footer>

<style>
  #shopify-section-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    flex: 0 0 auto;
  }

  #cf-footer-{{ section.id }} {
    display: block !important;
    box-sizing: border-box;
    background: #075844 !important;
    color: #eee9d8 !important;
    width: 100%;
    padding: 50px clamp(24px, 5vw, 94px) 0;
    font: 18px/1.5 Arial, Helvetica, sans-serif;
    text-align: left;
    position: relative;
    visibility: visible !important;
    opacity: 1 !important;
  }

  #cf-footer-{{ section.id }} * {
    box-sizing: border-box;
  }

  #cf-footer-{{ section.id }} a {
    color: inherit !important;
    text-decoration: none;
  }

  #cf-footer-{{ section.id }} a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  #cf-footer-{{ section.id }} a:focus-visible {
    outline: 2px solid #e8b84a;
    outline-offset: 6px;
  }

  #cf-footer-{{ section.id }} .cff-columns {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr .6fr;
    gap: 50px;
    align-items: start;
  }

  #cf-footer-{{ section.id }} .cff-columns > * {
    min-width: 0;
  }

  #cf-footer-{{ section.id }} .cff-logo {
    display: block;
    width: 300px;
    max-width: 100%;
  }

  #cf-footer-{{ section.id }} .cff-logo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    object-position: left;
    border: 0;
    border-radius: 0;
  }

  #cf-footer-{{ section.id }} .cff-brand p {
    font: inherit;
    letter-spacing: normal;
    color: inherit;
    margin: 20px 0 0;
    max-width: 290px;
  }

  #cf-footer-{{ section.id }} .cff-nav h2 {
    font: 700 18px/1.4 Arial, Helvetica, sans-serif;
    text-transform: uppercase;
    letter-spacing: normal;
    margin: 0 0 24px;
    color: inherit;
  }

  #cf-footer-{{ section.id }} .cff-nav a {
    display: block;
    font: inherit;
    line-height: 1.5;
    margin: 0 0 18px;
    width: fit-content;
    overflow-wrap: anywhere;
  }

  #cf-footer-{{ section.id }} .cff-social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  #cf-footer-{{ section.id }} .cff-social a {
    display: grid;
    place-items: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
  }

  #cf-footer-{{ section.id }} .cff-social a:hover {
    color: #e8b84a !important;
  }

  #cf-footer-{{ section.id }} .cff-social svg {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #cf-footer-{{ section.id }} .cff-social-dot,
  #cf-footer-{{ section.id }} .cff-social-fill {
    fill: currentColor;
    stroke: none;
  }

  #cf-footer-{{ section.id }} .cff-credits {
    margin-top: 36px;
    font-size: 14px;
  }

  #cf-footer-{{ section.id }} .cff-credits a {
    display: inline-block;
    padding-bottom: 5px;
    border-bottom: 1px solid #eee9d850;
  }

  #cf-footer-{{ section.id }} .cff-bottom {
    border-top: 1px solid #eee9d830;
    margin-top: 44px;
    padding: 26px 0;
    font-size: 14px;
    color: #d3dec9;
  }

  @media (max-width: 900px) {
    #cf-footer-{{ section.id }} .cff-columns {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 30px;
    }

    #cf-footer-{{ section.id }} .cff-social {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    #cf-footer-{{ section.id }} {
      padding: 38px 24px 0;
      font-size: 16px;
    }

    #cf-footer-{{ section.id }} .cff-columns {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }

    #cf-footer-{{ section.id }} .cff-brand {
      grid-column: 1 / -1;
    }

    #cf-footer-{{ section.id }} .cff-nav h2 {
      font-size: 15px;
      margin-bottom: 20px;
    }

    #cf-footer-{{ section.id }} .cff-logo {
      width: 240px;
    }

    #cf-footer-{{ section.id }} .cff-bottom {
      margin-top: 30px;
      padding: 22px 0;
    }
  }
</style>

{% schema %}
{
  "name": "Catalina’s Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "explore_menu",
      "label": "Explore menu"
    },
    {
      "type": "link_list",
      "id": "helpful_menu",
      "label": "Helpful links menu",
      "info": "Leave empty to show the store policies you have created."
    },
    {
      "type": "url",
      "id": "story_url",
      "label": "Our Story link (without menu)"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link (without menu)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "photo_credits_url",
      "label": "Photo credits URL (optional)"
    }
  ],
  "presets": [
    {
      "name": "Catalina’s Footer"
    }
  ]
}
{% endschema %}