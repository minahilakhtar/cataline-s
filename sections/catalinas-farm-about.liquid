<style>#cf-about .about-value{cursor:default}</style>
<style>
/* Decorative moving stars around the values section. */
#cf-{{ section.id }}-our-values{position:relative;isolation:isolate}
#cf-{{ section.id }}-our-values .about-values-layout{position:relative;z-index:1}
#cf-{{ section.id }}-our-values .cf-values-stars{position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden}
#cf-{{ section.id }}-our-values .cf-values-star{display:block;position:absolute;width:34px;height:34px;color:#c85c3b;animation:cfAboutStarDrift 7s ease-in-out infinite}
#cf-{{ section.id }}-our-values .cf-values-star svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;animation:cfAboutStarTurn 30s linear infinite}
#cf-{{ section.id }}-our-values .cf-values-star-1{top:16px;right:5%;width:38px;height:38px}
#cf-{{ section.id }}-our-values .cf-values-star-2{bottom:14px;left:4%;width:28px;height:28px;color:#b78b2a;animation-delay:-3s}
#cf-{{ section.id }}-our-values .cf-values-star-2 svg{animation-direction:reverse;animation-duration:24s}
#cf-{{ section.id }}-our-values .cf-values-star-3{top:48%;right:15px;width:23px;height:23px;color:#075844;opacity:.45;animation-delay:-5s}
@keyframes cfAboutStarDrift{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
@keyframes cfAboutStarTurn{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@media(max-width:620px){#cf-{{ section.id }}-our-values .cf-values-star-1{width:24px;height:24px;top:10px;right:22px}#cf-{{ section.id }}-our-values .cf-values-star-2{width:20px;height:20px;bottom:9px;left:22px}#cf-{{ section.id }}-our-values .cf-values-star-3{display:none}}
@media(prefers-reduced-motion:reduce){#cf-{{ section.id }}-our-values .cf-values-star,#cf-{{ section.id }}-our-values .cf-values-star svg{animation:none!important}}
</style>
{% schema %}{"name":"Catalina’s Farm About","tag":"section","class":"cf-about-section","limit":1,"enabled_on":{"templates":["page","index"]},"settings":[{"type":"url","id":"captions_url","label":"English captions (VTT URL)","info":"Add accurate captions if the film includes speech or meaningful audio."},{"type":"paragraph","content":"CSS, JavaScript and original font designs are embedded. Original photos, logos and film use the included media assets."},{"type":"image_picker","id":"header_logo","label":"Header logo"},{"type":"image_picker","id":"footer_logo","label":"Footer logo"},{"type":"image_picker","id":"banner_image","label":"Banner photograph"},{"type":"image_picker","id":"callout_image","label":"Lifestyle photograph"},{"type":"video","id":"farm_video","label":"Farm film"},{"type":"url","id":"video_url","label":"Alternative MP4 video URL"},{"type":"url","id":"shop_link","label":"Shop destination"},{"type":"url","id":"instagram_url","label":"Instagram URL"}],"presets":[{"name":"Catalina’s Farm About"}]}{% endschema %}
