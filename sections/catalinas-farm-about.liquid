{% assign newsletter_id = 'cf-newsletter-' | append: section.id %}
<div class="cf-about" id="CFAbout-{{ section.id }}" data-cf-about data-search-url="{{ routes.search_url }}"><a class="skip-link" href="#cf-{{ section.id }}-main-content">Skip to content</a><div class="progress-bar" aria-hidden="true"></div><div class="page" data-cf-id="top" id="cf-{{ section.id }}-top"><main tabindex="-1" class="about-main" data-cf-id="main-content" id="cf-{{ section.id }}-main-content"><section class="about-banner" aria-labelledby="cf-{{ section.id }}-about-title"><img src="{% if section.settings.banner_image != blank %}{{ section.settings.banner_image | image_url: width: 2400 }}{% else %}{{ 'cf-about-image-2.webp' | asset_url }}{% endif %}" alt="Farmland in warm evening sunlight" fetchpriority="high" width="1600" height="900"><div class="about-banner-inner"><div><div class="eyebrow">OUR ROOTS. OUR PURPOSE.</div><h1 data-cf-id="about-title" id="cf-{{ section.id }}-about-title">About <em>Catalina’s Farm.</em></h1></div><nav class="about-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span class="about-breadcrumb-current" aria-current="page">About us</span></nav></div></section><section class="about-intro about-intro-revised" data-cf-id="about-story" id="cf-{{ section.id }}-about-story" aria-labelledby="cf-{{ section.id }}-our-story-title"><div class="eyebrow">OUR STORY</div><h2 data-cf-id="our-story-title" id="cf-{{ section.id }}-our-story-title">A Little <em>About Us</em></h2><p>At Catalina’s Farm, we believe good products should be part of everyday life, not a luxury. We work with makers who care about what they do to bring you products that offer good quality at a fair price, from everyday essentials to little things that make life better. We believe in keeping things simple: products you can trust, prices that make sense, and a little more care for the people and planet around us.</p></section><section class="about-values about-values-revised" data-cf-id="our-values" id="cf-{{ section.id }}-our-values" aria-labelledby="cf-{{ section.id }}-values-title"><div class="cf-values-stars" aria-hidden="true"><span class="cf-values-star cf-values-star-1"><svg viewBox="0 0 64 64" focusable="false"><path d="M32 3v58M3 32h58M11.5 11.5l41 41M11.5 52.5l41-41"/></svg></span><span class="cf-values-star cf-values-star-2"><svg viewBox="0 0 64 64" focusable="false"><path d="M32 3v58M3 32h58M11.5 11.5l41 41M11.5 52.5l41-41"/></svg></span><span class="cf-values-star cf-values-star-3"><svg viewBox="0 0 64 64" focusable="false"><path d="M32 3v58M3 32h58M11.5 11.5l41 41M11.5 52.5l41-41"/></svg></span></div><div class="about-values-layout"><figure class="about-film"><video poster="{% if section.settings.banner_image != blank %}{{ section.settings.banner_image | image_url: width: 1600 }}{% else %}{{ 'cf-about-image-2.webp' | asset_url }}{% endif %}" class="about-farm-video" data-cf-id="about-farm-video" id="cf-{{ section.id }}-about-farm-video" src="https://cdn.shopify.com/videos/c/o/v/932d1919b8c2428dbe967536f5d885be.mp4" autoplay muted loop playsinline webkit-playsinline preload="metadata" controls controlslist="nodownload noplaybackrate" disablepictureinpicture aria-label="Farm film from Catalina’s Farm" aria-describedby="cf-{{ section.id }}-film-description">{% if section.settings.captions_url != blank %}<track kind="captions" src="{{ section.settings.captions_url | escape }}" srclang="en" label="English" default>{% endif %}Your browser does not support video.</video><p class="sr-only" id="cf-{{ section.id }}-film-description">A farm montage showing sunlit farmland, crops being tended, a field, fresh produce, and a red farm building.</p><figcaption class="about-film-status" role="status" hidden>Video playback is unavailable. Please use the video controls to try again.</figcaption></figure><div class="about-values-content"><div class="about-section-head"><h2 data-cf-id="values-title" id="cf-{{ section.id }}-values-title">Why <em>Choose Us</em></h2></div><div class="about-values-grid" role="group" aria-label="Explore our four values"><div class="about-value is-highlighted"><span class="about-value-top"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg></span><strong>Authenticity</strong><span>Honest partners. Thoughtful choices.</span></div><div class="about-value"><span class="about-value-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22V9M12 16C5 17 2 12 3 7c7-1 10 3 9 9Zm0-4c7 0 10-5 9-10-7 0-10 4-9 10Z"/></svg></span><strong>Sustainability</strong><span>Care for the land and the future.</span></div><div class="about-value"><span class="about-value-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3 12C-2 6 6 0 12 7c6-7 14-1 9 5Z"/></svg></span><strong>Wellbeing</strong><span>Better choices for everyday living.</span></div><div class="about-value"><span class="about-value-top"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="7" r="3"/><circle cx="18" cy="8" r="2"/><path d="M3 22v-7a6 6 0 0 1 12 0v7m2-9a4 4 0 0 1 5 4v5"/></svg></span><strong>Social impact</strong><span>People, community, and shared purpose.</span></div></div></div></div></section><section class="about-quote" aria-labelledby="cf-{{ section.id }}-belief-title"><span class="about-quote-mark" aria-hidden="true">“</span><div class="eyebrow" data-cf-id="belief-title" id="cf-{{ section.id }}-belief-title">A BELIEF WE COME BACK TO</div><blockquote>What is good for you<br>should also be <em>good for the world.</em></blockquote><p>Thoughtfully chosen. Naturally inspired. Always with purpose.</p></section><section class="about-callout" aria-labelledby="cf-{{ section.id }}-living-title"><img src="{% if section.settings.callout_image != blank %}{{ section.settings.callout_image | image_url: width: 2400 }}{% else %}{{ 'cf-about-image-3.webp' | asset_url }}{% endif %}" alt="A bright kitchen with fresh ingredients and everyday essentials" loading="lazy" width="1800" height="1079"><div class="about-callout-card"><div class="eyebrow">MADE FOR YOUR EVERYDAY</div><h2 data-cf-id="living-title" id="cf-{{ section.id }}-living-title">Small choices.<br><em>Meaningful living.</em></h2><p>We bring together the best products at the best quality at the best prices to make everyday life a little better. Simple, thoughtful choices for you, your home, and the people you care about.</p><a class="button" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Explore our products <span aria-hidden="true">↗</span></a></div></section><section class="newsletter" data-cf-id="contact" id="cf-{{ section.id }}-contact" aria-labelledby="cf-{{ section.id }}-newsletter-title"><div><div class="eyebrow">LET’S STAY CLOSE</div><h2 data-cf-id="newsletter-title" id="cf-{{ section.id }}-newsletter-title">A little goodness.<br><em>Straight to your inbox.</em></h2><p>Discover thoughtful finds and news from Catalina’s Farm.</p></div><div class="botanical" aria-hidden="true"><svg viewBox="0 0 150 230" aria-hidden="true"><path d="M73 222C79 168 70 110 88 16M77 178C24 173 13 137 18 117c42-3 66 26 59 61ZM77 142c48-6 67-36 61-61-36-1-65 25-61 61ZM78 103C34 98 26 65 31 47c33 0 51 24 47 56ZM85 66c31-4 45-24 41-46-27 1-41 19-41 46Z"/></svg></div><div class="newsletter-form-wrap">
{% form 'customer', id: newsletter_id, class: 'cf-newsletter-form' %}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <label for="cf-{{ section.id }}-email" class="sr-only">Email address</label>
  <input id="cf-{{ section.id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="Your email address" value="{{ form.email | escape }}" required {% if form.errors %}aria-invalid="true" aria-describedby="cf-{{ section.id }}-newsletter-error"{% elsif form.posted_successfully? %}aria-describedby="cf-{{ section.id }}-newsletter-success"{% endif %}>
  <button class="button" type="submit">Join the list</button>
{% if form.errors %}<div id="cf-{{ section.id }}-newsletter-error" class="newsletter-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
{% if form.posted_successfully? %}<p id="cf-{{ section.id }}-newsletter-success" class="newsletter-message" role="status" tabindex="-1">Thank you for joining!{% if shop.customer_accounts_optional %} Please check your inbox for any confirmation email.{% endif %}</p>{% endif %}
{% endform %}
</div></section></main></div><dialog aria-label="Catalina’s Farm" data-cf-id="modal" id="cf-{{ section.id }}-modal"><button class="dialog-close" aria-label="Close dialog">×</button><div class="dialog-content"></div></dialog><button type="button" hidden class="back-top" aria-label="Back to top">↑</button></div><script>(()=>{"use strict";if(window.CFAboutSections)return void window.CFAboutSections.init();const e=new Map;function t(t){if(e.has(t))return;const o=new AbortController,n=o.signal,a=(e,t,o,a={})=>e&&e.addEventListener(t,o,{...a,signal:n}),c=e=>t.querySelector(`[data-cf-id="${e}"]`),r=window.matchMedia("(prefers-reduced-motion: reduce)"),i=t.querySelector(".motion-toggle"),s=c("about-farm-video"),l=t.querySelector(".menu-toggle"),d=t.querySelector(".links"),u=t.querySelector(".nav"),m=c("modal"),h=m.querySelector(".dialog-content"),p=t.querySelector(".back-top"),y=t.querySelector(".progress-bar");let b=null,f="",g=r.matches,v=!0,w=0,S=!1,E=!1,q=!1;const x=[],A=()=>{d&&d.classList.remove("open"),l&&l.setAttribute("aria-expanded","false")};a(l,"click",()=>{const e=d.classList.toggle("open");l.setAttribute("aria-expanded",String(e))}),a(d,"click",e=>{e.target.closest("a")&&A()}),a(t,"keydown",e=>{"Escape"===e.key&&d&&d.classList.contains("open")&&(A(),l.focus())}),a(document,"click",e=>{u&&u.contains(e.target)||A()});const k=window.matchMedia("(min-width: 621px)");function C(){m.open&&m.close()}function L(e,o){b=document.activeElement,h.replaceChildren();const n=document.createElement("h2");n.id=`cf-${t.id}-dialog-title`,n.textContent=e,m.setAttribute("aria-labelledby",n.id),h.append(n),o(h),f=document.body.style.overflow,m.showModal(),document.body.style.overflow="hidden";const a=h.querySelector("input");a?a.focus():m.querySelector(".dialog-close").focus()}a(k,"change",A),a(m.querySelector(".dialog-close"),"click",C),a(m,"click",e=>{if(e.target!==m)return;const t=m.getBoundingClientRect();(e.clientX<t.left||e.clientX>t.right||e.clientY<t.top||e.clientY>t.bottom