<link
  rel="stylesheet"
  href="{{ 'home-v3-hero.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- style -%}
  .home-v3-left-slider {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .home-v3-left-slider [data-slider-track] {
    display: flex;
    width: 100%;
    transition: transform 0.3s ease;
  }

  .home-v3-left-slider [data-slider-slide] {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100%;
  }

  .home-v3-left-slider__slide {
    position: relative;
    width: 100%;
    height: 560px;
    overflow: hidden;
    border-radius: 8px;
  }

  .home-v3-left-slider__slide .section-2-column-banner__column-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-v3-left-slider__slide .section-2-column-banner__column-content {
    position: absolute;
    top: 50%;
    left: 72px;
    transform: translateY(-50%);
    z-index: 2;
  }

  .home-v3-left-slider .hero-slider-dots {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 5;
  }

  .home-v3-left-slider .hero-slider-dots button {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background-color: #c8c1b4;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .home-v3-left-slider .hero-slider-dots button.is-active {
    background-color: #5b6463;
  }

  .home-v3-left-slider .hero-slider-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .home-v3-left-slider .hero-slider-nav button {
    background: none;
    border: 0;
    cursor: pointer;
    width: 28px;
    height: 28px;
    padding: 0;
    color: rgb(var(--color-gray-500));
  }

  @media screen and (max-width: 749px) {
    .home-v3-left-slider__slide {
      height: 360px;
    }

    .home-v3-left-slider__slide .section-2-column-banner__column-content {
      left: 24px;
      right: 24px;
    }

    .home-v3-left-slider .hero-slider-dots {
      bottom: 18px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign left_slides = section.blocks | where: 'type', 'hero_slide'
  assign enable_left_slider = false

  if section.settings.enable_left_carousel and left_slides.size > 1
    assign enable_left_slider = true
  endif
-%}

<div
  class="home-v3-hero {{ section.settings.layout_style }}"
  style="margin: {{ section.settings.section_margin_all_sides }}; padding: {{ section.settings.section_padding_all_sides }};"
>
  <div class="page-width">
    <div class="section-2-column-banner__columns hero-column {{ section.type }}">
      <div class="section-2-column-banner__column first-column stretched-link">
        {% if left_slides.size > 0 %}
          <div
            class="home-v3-left-slider"
            {% if enable_left_slider %}
              data-slider
              data-autoplay="{{ section.settings.left_autoplay }}"
              data-speed="{{ section.settings.left_autoplay_speed }}"
              data-pause="true"
            {% endif %}
          >
            <div {% if enable_left_slider %}data-slider-track{% endif %}>
              {% for block in left_slides %}
                {%- liquid
                  assign left_btn_size_text = block.settings.btn_size_text
                  assign left_btn_color = block.settings.btn_color
                  assign left_btn_hover_color = block.settings.btn_hover_color
                  assign left_btn_bg_color = block.settings.btn_bg_color
                  assign left_btn_bg_hover_color = block.settings.btn_bg_hover_color
                  assign left_btn_border = block.settings.btn_border
                  assign left_btn_border_color = block.settings.btn_border_color
                  assign left_btn_border_hover_color = block.settings.btn_border_hover_color
                -%}

                <div {% if enable_left_slider %}data-slider-slide{% endif %} {{ block.shopify_attributes }}>
                  <div
                    class="home-v3-left-slider__slide stretched-link"
                    style="min-height:{{ block.settings.img_height }}px"
                  >
                    {% if block.settings.image %}
                      {% if forloop.first %}
                        <img
                          src="{{ block.settings.image | image_url: width: block.settings.img_width, height: block.settings.img_height }}"
                          width="{{ block.settings.img_width }}"
                          height="{{ block.settings.img_height }}"
                          alt="{{ block.settings.image_alt | escape }}"
                          class="section-2-column-banner__column-image"
                          loading="eager"
                          fetchpriority="high"
                        >
                      {% else %}
                        <img
                          src="{{ block.settings.image | image_url: width: block.settings.img_width, height: block.settings.img_height }}"
                          width="{{ block.settings.img_width }}"
                          height="{{ block.settings.img_height }}"
                          alt="{{ block.settings.image_alt | escape }}"
                          class="section-2-column-banner__column-image"
                          loading="lazy"
                        >
                      {% endif %}
                    {% else %}
                      <p style="width: 100%; height: {{ block.settings.img_height }}px; margin: 0;">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </p>
                    {% endif %}

                    <div class="section-2-column-banner__column-content">
                      {% if block.settings.pretitle %}
                        <{{ block.settings.pretitle_font_size }}
                          class="pretitle"
                          style="
                            color: {{ block.settings.pretitle_color }};
                            font-weight: {{ block.settings.pretitle_font_weight }};
                            line-height: {{ block.settings.pretitle_lineheight }};
                            text-transform: {{ block.settings.pretitle_txt_style }};
                          "
                        >
                          {{ block.settings.pretitle }}

                          {% if block.settings.pretitle_badge != blank %}
                            <span
                              class="offer-badge"
                              style="
                                background-color: {{ block.settings.pretitle_badge_bg }};
                                color: {{ block.settings.pretitle_badge_color }};
                                font-size: {{ block.settings.pretitle_badge_font_size }}px;
                                border-radius: {{ block.settings.pretitle_badge_radius }}px;
                                padding: {{ block.settings.pretitle_badge_padding }};
                              "
                            >
                              {{ block.settings.pretitle_badge }}
                            </span>
                          {% endif %}
                        </{{ block.settings.pretitle_font_size }}>
                      {% endif %}

                      {% if block.settings.heading %}
                        <h1
                          class="section-heading {{ block.settings.heading_font_size }}"
                          style="
                            color: {{ block.settings.heading_color }};
                            font-weight: {{ block.settings.heading_font_weight }};
                            line-height: {{ block.settings.heading_lineheight }};
                            margin: {{ block.settings.heading_margin }};
                            text-transform: {{ block.settings.heading_txt_style }};
                            letter-spacing: -.03rem;
                          "
                        >
                          {{ block.settings.heading | newline_to_br }}
                        </h1>
                      {% endif %}

                      {% if block.settings.posttitle %}
                        <{{ block.settings.posttitle_font_size }}
                          style="
                            color: {{ block.settings.posttitle_color }};
                            font-weight: {{ block.settings.posttitle_font_weight }};
                            line-height: {{ block.settings.posttitle_lineheight }};
                            margin: {{ block.settings.posttitle_margin }};
                            text-transform: {{ block.settings.posttitle_txt_style }};
                          "
                        >
                          {{ block.settings.posttitle }}
                        </{{ block.settings.posttitle_font_size }}>
                      {% endif %}

                      {% if block.settings.description %}
                        <{{ block.settings.desc_font_size }}
                          style="
                            color: {{ block.settings.desc_color }};
                            font-weight: {{ block.settings.desc_font_weight }};
                            line-height: {{ block.settings.desc_lineheight }};
                            margin: {{ block.settings.desc_margin }};
                            text-transform: {{ block.settings.desc_txt_style }};
                          "
                        >
                          {{ block.settings.description }}

                          {% if block.settings.price_text != blank %}
                            <span
                              style="
                                color: {{ block.settings.price_color }};
                                font-size: {{ block.settings.price_font_size }}px;
                                font-weight: {{ block.settings.price_font_weight }};
                              "
                            >
                              {{ block.settings.price_text }}
                            </span>
                          {% endif %}
                        </{{ block.settings.desc_font_size }}>
                      {% endif %}

                      {% if block.settings.button_text %}
                        <div class="freshcart-home-v3-column-1-button {{ block.settings.btn_style }} button button__left_{{ block.id }}">
                          <style>
                            .button.button__left_{{ block.id }} {
                              width: fit-content;
                            }

                            .button.button__left_{{ block.id }} a {
                              font-size: {{ left_btn_size_text }};
                              cursor: pointer;
                              color: {{ left_btn_color }};
                              line-height: 1.2;
                              display: block;
                              transition: 0.3s ease-in-out;
                              position: static;
                              width: fit-content;
                            }

                            .button.button__left_{{ block.id }} a:before {
                              position: absolute;
                              top: 0;
                              right: 0;
                              bottom: 0;
                              left: 0;
                              z-index: 1;
                              content: "";
                              display: block;
                            }

                            {%- if block.settings.btn_style != 'btn-link' -%}
                              .button.button__left_{{ block.id }} a {
                                padding: {{ block.settings.btn_padding }};
                                margin: {{ block.settings.btn_margin }};
                                border: {{ left_btn_border }}px solid {{ left_btn_border_color }};
                                border-radius: {{ block.settings.btn_border_radius }};
                                text-decoration: none;
                              }
                            {%- endif -%}

                            {%- if block.settings.btn_style == 'btn-fill' -%}
                              .button.button__left_{{ block.id }} a {
                                background-color: {{ left_btn_bg_color }};
                                border: {{ left_btn_border }}px solid {{ left_btn_border_color }};
                              }

                              .button.button__left_{{ block.id }} a:hover,
                              .button.button__left_{{ block.id }} a:focus {
                                background-color: {{ left_btn_bg_hover_color }};
                                color: {{ left_btn_hover_color }};
                                border: {{ left_btn_border }}px solid {{ left_btn_border_hover_color }};
                              }
                            {%- elsif block.settings.btn_style == 'btn-outline' -%}
                              .button.button__left_{{ block.id }} a {
                                background-color: transparent;
                              }

                              .button.button__left_{{ block.id }} a:hover,
                              .button.button__left_{{ block.id }} a:focus {
                                border: {{ left_btn_border }}px solid {{ left_btn_border_hover_color }};
                                color: {{ left_btn_hover_color }};
                              }
                            {%- elsif block.settings.btn_style == 'btn-link' -%}
                              .button.button__left_{{ block.id }} a {
                                text-decoration: underline;
                                background: transparent;
                              }

                              .button.button__left_{{ block.id }} a:hover,
                              .button.button__left_{{ block.id }} a:focus {
                                color: {{ left_btn_hover_color }};
                              }
                            {%- endif -%}
                          </style>

                          <a
                            class="button__link"
                            href="{{ block.settings.button_url }}"
                          >
                            {{ block.settings.button_text }}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if enable_left_slider and section.settings.left_show_dots %}
              <div class="hero-slider-dots" data-dots></div>
            {% endif %}

            {% if enable_left_slider and section.settings.left_show_arrows %}
              <div class="hero-slider-nav">
                <button type="button" data-prev aria-label="Previous slide">‹</button>
                <button type="button" data-next aria-label="Next slide">›</button>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="section-2-column-banner__column second-column stretched-link">
        {% for block in section.blocks %}
          {%- liquid
            assign btn_size_text = block.settings.btn_size_text
            assign btn_color = block.settings.btn_color
            assign btn_hover_color = block.settings.btn_hover_color
            assign btn_bg_color = block.settings.btn_bg_color
            assign btn_bg_hover_color = block.settings.btn_bg_hover_color
            assign btn_border = block.settings.btn_border
            assign btn_border_color = block.settings.btn_border_color
            assign btn_border_hover_color = block.settings.btn_border_hover_color
          -%}

          {% if block.type == 'banner' %}
            <div class="second-column-inner" style="min-height:{{ block.settings.img_height }}px" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: block.settings.img_width, height: block.settings.img_height }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  class="section-2-column-banner__column-image"
                  width="{{ block.settings.img_width }}"
                  height="{{ block.settings.img_height }}"
                  loading="eager"
                >
              {% else %}
                <p style="width: 100%; height: {{ block.settings.img_height }}px; margin: 0;">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </p>
              {% endif %}

              <div class="section-2-column-banner__column-content">
                {% if block.settings.pretitle %}
                  <{{ block.settings.pretitle_font_size }}
                    class="pretitle"
                    style="
                      color: {{ block.settings.pretitle_color }};
                      font-weight: {{ block.settings.pretitle_font_weight }};
                      line-height: {{ block.settings.pretitle_lineheight }};
                      text-transform: {{ block.settings.pretitle_txt_style }};
                    "
                  >
                    {{ block.settings.pretitle }}
                  </{{ block.settings.pretitle_font_size }}>
                {% endif %}

                {% if block.settings.heading %}
                  <h1
                    class="heading {{ block.settings.heading_font_size }}"
                    style="
                      color: {{ block.settings.heading_color }};
                      font-weight: {{ block.settings.heading_font_weight }};
                      line-height: {{ block.settings.heading_lineheight }};
                      margin: {{ block.settings.heading_margin }};
                      text-transform: {{ block.settings.heading_txt_style }};
                    "
                  >
                    {{ block.settings.heading | newline_to_br }}
                  </h1>
                {% endif %}

                {% if block.settings.posttitle %}
                  <{{ block.settings.posttitle_font_size }}
                    class="banner_posttitle"
                    style="
                      color: {{ block.settings.posttitle_color }};
                      font-weight: {{ block.settings.posttitle_font_weight }};
                      line-height: {{ block.settings.posttitle_lineheight }};
                      margin: {{ block.settings.posttitle_margin }};
                      text-transform: {{ block.settings.posttitle_txt_style }};
                    "
                  >
                    {{ block.settings.posttitle }}
                  </{{ block.settings.posttitle_font_size }}>
                {% endif %}

                {% if block.settings.description %}
                  <{{ block.settings.desc_font_size }}
                    class="banner_desc"
                    style="
                      color: {{ block.settings.desc_color }};
                      font-weight: {{ block.settings.desc_font_weight }};
                      line-height: {{ block.settings.desc_lineheight }};
                      margin: {{ block.settings.desc_margin }};
                      text-transform: {{ block.settings.desc_txt_style }};
                    "
                  >
                    {{ block.settings.description }}

                    {% if block.settings.price_text != blank %}
                      <span
                        style="
                          color: {{ block.settings.price_color }};
                          font-size: {{ block.settings.price_font_size }}px;
                          font-weight: {{ block.settings.price_font_weight }};
                        "
                      >
                        {{ block.settings.price_text }}
                      </span>
                    {% endif %}
                  </{{ block.settings.desc_font_size }}>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <div class="freshcart-home-v3-column-2-button {{ block.settings.btn_style }} button__{{ block.id }}">
                    <style>
                      .freshcart-home-v3-column-2-button.button__{{ block.id }} {
                        width: fit-content;
                      }

                      .freshcart-home-v3-column-2-button.button__{{ block.id }} a {
                        font-size: {{ btn_size_text }};
                        font-weight: 600px;
                        cursor: pointer;
                        color: {{ btn_color }};
                        line-height: 1.2;
                        display: block;
                        transition: 0.3s ease-in-out;
                        position: static;
                        width: fit-content;
                      }

                      .freshcart-home-v3-column-2-button.button__{{ block.id }} a:before {
                        position: absolute;
                        top: 0;
                        right: 0;
                        bottom: 0;
                        left: 0;
                        z-index: 1;
                        content: "";
                        display: block;
                      }

                      {%- if block.settings.btn_style != 'btn-link' -%}
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a {
                          padding: {{ block.settings.btn_padding }};
                          margin: {{ block.settings.btn_margin }};
                          border: {{ btn_border }}px solid {{ btn_border_color }};
                          border-radius: {{ block.settings.btn_border_radius }};
                          text-decoration: none;
                        }
                      {%- endif -%}

                      {%- if block.settings.btn_style == 'btn-fill' -%}
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a {
                          background-color: {{ btn_bg_color }};
                          border: {{ btn_border }}px solid {{ btn_border_color }};
                        }

                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:hover,
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:focus {
                          background-color: {{ btn_bg_hover_color }};
                          color: {{ btn_hover_color }};
                          border: {{ btn_border }}px solid {{ btn_border_hover_color }};
                        }
                      {%- elsif block.settings.btn_style == 'btn-outline' -%}
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a {
                          background-color: transparent;
                        }

                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:hover,
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:focus {
                          border: {{ btn_border }}px solid {{ btn_border_hover_color }};
                          color: {{ btn_hover_color }};
                        }
                      {%- elsif block.settings.btn_style == 'btn-link' -%}
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a {
                          text-decoration: underline;
                          background: transparent;
                        }

                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:hover,
                        .freshcart-home-v3-column-2-button.button__{{ block.id }} a:focus {
                          color: {{ btn_hover_color }};
                        }
                      {%- endif -%}
                    </style>

                    <a
                      class="button__link"
                      href="{{ block.settings.button_url }}"
                    >
                      {{ block.settings.button_text }}
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.home-v3-hero.name",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:sections.home-v3-hero.settings.layout_style.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.home-v3-hero.settings.layout_style.options__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.home-v3-hero.settings.layout_style.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.home-v3-hero.settings.left_carousel.content"
    },
    {
      "type": "checkbox",
      "id": "enable_left_carousel",
      "label": "t:sections.home-v3-hero.settings.enable_left_carousel.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "left_show_arrows",
      "label": "t:sections.home-v3-hero.settings.left_show_arrows.label",
      "default": false,
      "visible_if": "{{ section.settings.enable_left_carousel }}"
    },
    {
      "type": "checkbox",
      "id": "left_show_dots",
      "label": "t:sections.home-v3-hero.settings.left_show_dots.label",
      "default": true,
      "visible_if": "{{ section.settings.enable_left_carousel }}"
    },
    {
      "type": "checkbox",
      "id": "left_autoplay",
      "label": "t:sections.home-v3-hero.settings.left_autoplay.label",
      "default": true,
      "visible_if": "{{ section.settings.enable_left_carousel }}"
    },
    {
      "type": "range",
      "id": "left_autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.home-v3-hero.settings.left_autoplay_speed.label",
      "default": 4,
      "visible_if": "{{ section.settings.enable_left_carousel and section.settings.left_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:sections.home-v3-hero.settings.section_setting.content"
    },
    {
      "type": "text",
      "id": "section_padding_all_sides",
      "label": "t:sections.home-v3-hero.settings.section_padding_all_sides.label",
      "default": "0px 0px 0px 0px",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "section_margin_all_sides",
      "label": "t:sections.home-v3-hero.settings.section_margin_all_sides.label",
      "default": "32px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "t:sections.home-v3-hero.blocks.hero_slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.image.label"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.image_alt.label",
          "default": "Banner image"
        },
        {
          "type": "text",
          "id": "img_width",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.img_width.label",
          "default": "850"
        },
        {
          "type": "text",
          "id": "img_height",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.img_height.label",
          "default": "560"
        },
        {
          "type": "header",
          "content": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_setting.content"
        },
        {
          "type": "text",
          "id": "pretitle",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle.label",
          "default": "Exclusive Offer"
        },
        {
          "type": "color",
          "id": "pretitle_color",
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_color.label",
          "default": "#5c6c75"
        },
        {
          "type": "select",
          "id": "pretitle_txt_style",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_txt_style.options__1.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_txt_style.options__2.label"
            },
            {
              "value": "lowercase",
              "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_txt_style.options__3.label"
            }
          ],
          "label": "t:sections.home-v3-hero.blocks.hero_slide.settings.pretitle_txt_style.label"
        },
        {
          "type": "select",
          "id": "pretitle_font_size",
          "default": "h6",
          "options": [
