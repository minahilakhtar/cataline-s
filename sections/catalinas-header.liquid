{% liquid
  assign header_menu = section.settings.menu
  assign home_url = 'https://catalinasfarm.com/pages/home'
  assign story_url = 'https://catalinasfarm.com/pages/about-us'
  assign contact_url = 'https://catalinasfarm.com/pages/contact-us'
%}
<div id="cf-header-{{ section.id }}" class="cfh" data-cfh data-cart-url="{{ routes.cart_url | escape }}">
  {% if section.settings.announcement != blank %}<div class="cfh-announcement">{{ section.settings.announcement | escape }}</div>{% endif %}
  <header class="cfh-bar">
    <details class="cfh-mobile">
      <summary aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></summary>
      <nav aria-label="Mobile navigation" class="cfh-mobile-panel">
        {% if header_menu != blank %}
          {% for link in header_menu.links %}
            {% liquid
              assign nav_url = link.url
              assign nav_label = link.title | handleize
              case nav_label
                when 'home'
                  assign nav_url = home_url
                when 'about', 'about-us', 'our-story'
                  assign nav_url = story_url
                when 'contact', 'contact-us'
                  assign nav_url = contact_url
              endcase
              assign nav_path = nav_url | remove: 'https://catalinasfarm.com'
            %}
            <a href="{{ nav_url }}" {% if request.path == nav_path %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {% for child in link.links %}<a class="cfh-child" href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="cfh-grandchild" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}
          {% endfor %}
        {% else %}<a href="{{ home_url }}">Home</a><a href="{{ story_url }}">Our Story</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ contact_url }}">Contact</a>{% endif %}
      </nav>
    </details>
    <a href="{{ home_url }}" class="cfh-logo" aria-label="{{ shop.name | escape }} — home">
      <img src="https://cdn.shopify.com/s/files/1/0957/1775/3123/files/logocatalinas.png?v=1774644746" width="220" height="110" alt="{{ shop.name | escape }}" loading="eager">
    </a>
    <nav class="cfh-desktop" aria-label="Main navigation">
      {% if header_menu != blank %}
        {% for link in header_menu.links %}
            {% liquid
              assign nav_url = link.url
              assign nav_label = link.title | handleize
              case nav_label
                when 'home'
                  assign nav_url = home_url
                when 'about', 'about-us', 'our-story'
                  assign nav_url = story_url
                when 'contact', 'contact-us'
                  assign nav_url = contact_url
              endcase
              assign nav_path = nav_url | remove: 'https://catalinasfarm.com'
            %}
          {% if link.links != blank %}<details class="cfh-dropdown"><summary>{{ link.title | escape }} <span aria-hidden="true">⌄</span></summary><div class="cfh-submenu"><a href="{{ nav_url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="cfh-child" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></details>{% else %}<a href="{{ nav_url }}" {% if request.path == nav_path %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
        {% endfor %}
      {% else %}<a href="{{ home_url }}">Home</a><a href="{{ story_url }}">Our Story</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ contact_url }}">Contact</a>{% endif %}
    </nav>
    <div class="cfh-actions">
      <a href="{{ routes.search_url }}" class="cfh-icon" data-cfh-search aria-label="Search" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 6 6"/></svg></a>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="cfh-icon" aria-label="{% if customer %}My account{% else %}Sign in{% endif %}" rel="nofollow"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3.3"/><path d="M5 22v-3a7 7 0 0 1 14 0v3Z"/></svg></a>
      <a href="{{ routes.cart_url }}" class="cfh-icon cfh-cart" aria-label="Shopping bag, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1.5 15h-17L5 7Z"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/></svg><span class="cfh-count" data-cfh-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></a>
    </div>
  </header>
  <dialog class="cfh-search-dialog" aria-labelledby="cfh-search-title-{{ section.id }}">
    <div class="cfh-search-heading"><h2 id="cfh-search-title-{{ section.id }}">What are you looking for?</h2><button type="button" class="cfh-close" data-cfh-close aria-label="Close search">×</button></div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="cfh-search-form">
      <label class="cfh-visually-hidden" for="cfh-query-{{ section.id }}">Search the store</label>
      <input id="cfh-query-{{ section.id }}" type="search" name="q" placeholder="Search products…" required autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit">Search <span aria-hidden="true">↗</span></button>
    </form>
  </dialog>
</div>
<style>
#shopify-section-{{ section.id }}{position:relative;z-index:30;margin:0;padding:0;width:100%;max-width:none}
#cf-header-{{ section.id }}{--cfh-green:#075844;--cfh-white:#fff;display:block;width:100%;font-family:Arial,Helvetica,sans-serif;color:var(--cfh-green);line-height:1.4;text-align:left;background:var(--cfh-white)}
#cf-header-{{ section.id }} *{box-sizing:border-box}
#cf-header-{{ section.id }} [hidden]{display:none!important}
#cf-header-{{ section.id }} a{color:inherit;text-decoration:none}
#cf-header-{{ section.id }} button,#cf-header-{{ section.id }} input{font:inherit}
#cf-header-{{ section.id }} :is(a,button,summary,input):focus-visible{outline:2px solid var(--cfh-green);outline-offset:5px}
#cf-header-{{ section.id }} .cfh-announcement{background:var(--cfh-green);color:white;text-align:center;font-size:14px;font-weight:600;letter-spacing:.1px;padding:16px 20px;min-height:52px}
#cf-header-{{ section.id }} .cfh-bar{min-height:112px;padding:12px clamp(24px,5.1vw,98px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:28px;background:#fff;position:relative}
#cf-header-{{ section.id }} .cfh-logo{display:block;justify-self:start;width:{{ section.settings.logo_width }}px;max-width:100%}
#cf-header-{{ section.id }} .cfh-logo img{display:block;width:100%;height:auto;max-height:92px;object-fit:contain;object-position:left center;border:0;border-radius:0}
#cf-header-{{ section.id }} .cfh-desktop{display:flex;align-items:center;gap:42px;font-size:20px;font-weight:400}
#cf-header-{{ section.id }} .cfh-desktop>a,#cf-header-{{ section.id }} .cfh-dropdown>summary{padding:12px 0;white-space:nowrap}
#cf-header-{{ section.id }} .cfh-desktop a:hover{text-decoration:underline;text-underline-offset:6px}
#cf-header-{{ section.id }} .cfh-actions{justify-self:end;display:flex;align-items:center;gap:38px}
#cf-header-{{ section.id }} .cfh-icon{display:flex;align-items:center;justify-content:center;position:relative;width:30px;height:44px;flex-shrink:0}
#cf-header-{{ section.id }} svg{display:block;width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
#cf-header-{{ section.id }} .cfh-count{position:absolute;right:-8px;top:0;min-width:18px;height:18px;display:grid;place-items:center;border-radius:50%;padding:0 4px;background:var(--cfh-green);color:white;font-size:10px;line-height:1}
#cf-header-{{ section.id }} summary{list-style:none;cursor:pointer}
#cf-header-{{ section.id }} summary::-webkit-details-marker{display:none}
#cf-header-{{ section.id }} .cfh-dropdown{position:relative}
#cf-header-{{ section.id }} .cfh-submenu{position:absolute;top:100%;left:-20px;min-width:210px;background:#fff;padding:16px 20px;border:1px solid #07584420;box-shadow:0 12px 25px #07584412;z-index:5;font-size:16px}
#cf-header-{{ section.id }} .cfh-submenu a{display:block;padding:9px 0}
#cf-header-{{ section.id }} .cfh-mobile{display:none}
#cf-header-{{ section.id }} .cfh-search-dialog{width:min(680px,calc(100% - 32px));max-height:85vh;padding:32px;border:0;border-radius:16px;color:var(--cfh-green);background:#fff;box-shadow:0 20px 80px #0003;margin:auto}
#cf-header-{{ section.id }} .cfh-search-dialog:not([open]){display:none}
#cf-header-{{ section.id }} .cfh-search-dialog::backdrop{background:#082b2380}
#cf-header-{{ section.id }} .cfh-search-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}
#cf-header-{{ section.id }} .cfh-search-heading h2{font:500 23px/1.3 Arial,sans-serif;margin:0;color:inherit;letter-spacing:normal}
#cf-header-{{ section.id }} .cfh-close{font-size:30px;background:transparent;border:0;color:inherit;cursor:pointer;padding:0 8px}
#cf-header-{{ section.id }} .cfh-search-form{display:flex;gap:12px}
#cf-header-{{ section.id }} .cfh-search-form input{width:100%;min-width:0;padding:14px;border:1px solid #07584460;border-radius:5px;background:white;color:var(--cfh-green);font-size:16px}
#cf-header-{{ section.id }} .cfh-search-form button{padding:14px 20px;border:0;border-radius:5px;background:var(--cfh-green);color:white;cursor:pointer;white-space:nowrap}
#cf-header-{{ section.id }} .cfh-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(max-width:1000px){#cf-header-{{ section.id }} .cfh-desktop{gap:23px;font-size:17px}#cf-header-{{ section.id }} .cfh-actions{gap:20px}#cf-header-{{ section.id }} .cfh-bar{padding-inline:28px;gap:20px}#cf-header-{{ section.id }} .cfh-logo{max-width:170px}}
@media(max-width:749px){#cf-header-{{ section.id }} .cfh-announcement{font-size:11px;padding:11px 15px;min-height:38px}#cf-header-{{ section.id }} .cfh-bar{grid-template-columns:36px 1fr auto;gap:12px;padding:10px 16px;min-height:84px}#cf-header-{{ section.id }} .cfh-desktop{display:none}#cf-header-{{ section.id }} .cfh-mobile{display:block}#cf-header-{{ section.id }} .cfh-mobile summary{display:grid;place-items:center;width:32px;height:44px}#cf-header-{{ section.id }} .cfh-logo{width:130px;justify-self:start}#cf-header-{{ section.id }} .cfh-logo img{max-height:64px}#cf-header-{{ section.id }} .cfh-actions{gap:10px}#cf-header-{{ section.id }} .cfh-icon{width:26px}#cf-header-{{ section.id }} .cfh-icon svg{width:21px;height:21px}#cf-header-{{ section.id }} .cfh-mobile-panel{position:absolute;top:100%;left:0;right:0;background:#fff;border-top:1px solid #07584420;box-shadow:0 14px 22px #07584412;padding:14px 24px;max-height:65vh;overflow:auto}#cf-header-{{ section.id }} .cfh-mobile-panel a{display:block;padding:12px 0;font-size:17px}#cf-header-{{ section.id }} .cfh-child{padding-left:16px!important}#cf-header-{{ section.id }} .cfh-grandchild{padding-left:32px!important}#cf-header-{{ section.id }} .cfh-search-dialog{padding:24px 18px}#cf-header-{{ section.id }} .cfh-search-heading h2{font-size:20px}}
@media(max-width:359px){#cf-header-{{ section.id }} .cfh-logo{width:105px}#cf-header-{{ section.id }} .cfh-actions{gap:6px}}

/* Keep the static header visible when theme styles target header elements. */
#shopify-section-{{ section.id }} { display:block!important; visibility:visible!important; opacity:1!important; position:relative!important; height:auto!important; min-height:0!important; max-height:none!important; overflow:visible!important; flex:0 0 auto; transform:none!important; }
#cf-header-{{ section.id }} { display:block!important; visibility:visible!important; opacity:1!important; position:relative!important; height:auto!important; overflow:visible!important; transform:none!important; color:#075844!important; background:#fff!important; font-size:16px; }
#cf-header-{{ section.id }} .cfh-bar { display:grid!important; visibility:visible!important; opacity:1!important; position:relative!important; inset:auto!important; transform:none!important; height:auto!important; max-height:none!important; overflow:visible!important; color:#075844!important; background:#fff!important; }
#cf-header-{{ section.id }} .cfh-announcement { display:block!important; visibility:visible!important; opacity:1!important; color:#fff!important; background:#075844!important; }
#cf-header-{{ section.id }} .cfh-actions { display:flex!important; visibility:visible!important; opacity:1!important; }
#cf-header-{{ section.id }} .cfh-logo { display:block!important; visibility:visible!important; opacity:1!important; }
#cf-header-{{ section.id }} svg { visibility:visible!important; opacity:1!important; }
@media(min-width:750px) { #cf-header-{{ section.id }} .cfh-desktop { display:flex!important; visibility:visible!important; opacity:1!important; } }

/* Only the white navigation remains visible while the announcement scrolls away. */
#shopify-section-{{ section.id }} {
  position:sticky!important;
  top:var(--cfh-sticky-offset,0px)!important;
  z-index:40!important;
  align-self:stretch;
}
</style>
<script>
(()=>{
  if(window.CatalinasHeader){window.CatalinasHeader.init();return;}
  const instances=new Map();
  function init(){document.querySelectorAll('[data-cfh]').forEach(root=>{
    if(instances.has(root))return;
    const controller=new AbortController(),signal=controller.signal;
    const wrapper=root.closest('.shopify-section')||root.parentElement;
    const announcement=root.querySelector('.cfh-announcement');
    const measureHeader=()=>wrapper.style.setProperty('--cfh-sticky-offset',announcement?'-'+announcement.offsetHeight+'px':'0px');
    measureHeader();
    const headerObserver=typeof ResizeObserver==='function'?new ResizeObserver(measureHeader):null;
    if(headerObserver&&announcement)headerObserver.observe(announcement);
    window.addEventListener('resize',measureHeader,{signal});

    const on=(target,event,fn)=>target.addEventListener(event,fn,{signal});
    const dialog=root.querySelector('dialog'),trigger=root.querySelector('[data-cfh-search]');
    on(trigger,'click',event=>{if(typeof dialog.showModal!=='function')return;event.preventDefault();dialog.showModal();dialog.querySelector('input[type=search]').focus();});
    on(root.querySelector('[data-cfh-close]'),'click',()=>dialog.close());
    on(dialog,'click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();});
    on(dialog,'close',()=>trigger.focus());
    on(document,'keydown',event=>{if(event.key==='Escape')root.querySelectorAll('details[open]').forEach(el=>el.open=false);});
    on(document,'click',event=>{if(!root.contains(event.target))root.querySelectorAll('details[open]').forEach(el=>el.open=false);});
    function update(cart){if(!cart||!Number.isInteger(cart.item_count))return;const badge=root.querySelector('[data-cfh-count]');badge.textContent=String(cart.item_count);badge.hidden=cart.item_count===0;root.querySelector('.cfh-cart').setAttribute('aria-label','Shopping bag, '+cart.item_count+' items');}
    let request=0;
    async function refresh(){const current=++request;try{const response=await fetch(root.dataset.cartUrl+'.js',{headers:{Accept:'application/json'},credentials:'same-origin',cache:'no-store',signal});if(response.ok){const cart=await response.json();if(current===request)update(cart);}}catch(error){}}
    ['cart:updated','cart:update','cart:refresh'].forEach(event=>on(document,event,()=>refresh()));
    on(window,'focus',refresh);on(window,'pageshow',refresh);refresh();
    instances.set(root,()=>{if(headerObserver)headerObserver.disconnect();controller.abort();if(dialog.open)dialog.close();instances.delete(root);});
  });}
  window.CatalinasHeader={init};
  document.addEventListener('shopify:section:load',init);
  document.addEventListener('shopify:section:unload',event=>{instances.forEach((destroy,root)=>{if(event.target.contains(root))destroy();});});
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>
{% schema %}
{
  "name":"Catalina’s Header",
  "settings":[
    {"type":"text","id":"announcement","label":"Announcement","default":"Naturally inspired. Carefully chosen. Always with purpose."},
    {"type":"range","id":"logo_width","label":"Desktop logo width","min":100,"max":260,"step":10,"unit":"px","default":190},
    {"type":"link_list","id":"menu","label":"Navigation menu"},
    {"type":"url","id":"story_url","label":"Our Story link (when no menu selected)"},
    {"type":"url","id":"contact_url","label":"Contact link (when no menu selected)"}
  ],
  "presets":[{"name":"Catalina’s Header"}]
}
{% endschema %}
