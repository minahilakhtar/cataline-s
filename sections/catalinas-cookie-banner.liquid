{{ 'catalinas-cookie-banner.css' | asset_url | stylesheet_tag }}
<div id="cf-cookie-consent" hidden>
  <aside class="cf-cookie-bar" aria-label="Cookie consent" aria-describedby="cf-cookie-copy" hidden>
    <p id="cf-cookie-copy">We use cookies to improve your experience, personalize content, and understand how you use our store. You can change your choice at any time. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a></p>
    <div class="cf-cookie-actions">
      <button type="button" data-cf-cookie-action="accept">Accept All</button>
      <button type="button" data-cf-cookie-action="essential">Only Essential</button>
      <button type="button" class="cf-cookie-outline" data-cf-cookie-action="preferences">Preferences</button>
      <button type="button" data-cf-cookie-action="decline">Decline</button>
    </div>
    <p class="cf-cookie-status" role="status" aria-live="polite"></p>
  </aside>
  <button type="button" class="cf-cookie-reopen" data-cf-cookie-action="preferences" hidden>Cookie settings</button>
  <dialog class="cf-cookie-dialog" aria-labelledby="cf-cookie-title" aria-describedby="cf-cookie-description">
    <div class="cf-cookie-modal-head"><h2 id="cf-cookie-title">Your cookie preferences</h2><button type="button" class="cf-cookie-close" aria-label="Close cookie preferences" data-cf-cookie-close>×</button></div>
    <p id="cf-cookie-description">Choose which optional cookies you allow. Essential cookies keep the store, shopping cart, and checkout working and are always active.</p>
    <form class="cf-cookie-form">
      <div class="cf-cookie-option"><div><strong>Essential</strong><p>Required for security and core store functionality.</p></div><span class="cf-cookie-required">Always active</span></div>
      <label class="cf-cookie-option"><span><strong>Preferences</strong><span class="cf-cookie-detail">Remember choices such as your language or region.</span></span><input type="checkbox" name="preferences"></label>
      <label class="cf-cookie-option"><span><strong>Analytics</strong><span class="cf-cookie-detail">Help us understand visits and improve the store.</span></span><input type="checkbox" name="analytics"></label>
      <label class="cf-cookie-option"><span><strong>Marketing</strong><span class="cf-cookie-detail">Support personalized advertising and measure campaigns.</span></span><input type="checkbox" name="marketing"></label>
      <label class="cf-cookie-option" data-cf-sale-option hidden><span><strong>Do not sell or share my personal information</strong><span class="cf-cookie-detail">Opt out of sharing for targeted advertising. Global Privacy Control is respected by Shopify.</span></span><input type="checkbox" name="sale_opt_out"></label>
      <p class="cf-cookie-status" role="status" aria-live="polite"></p>
      <div class="cf-cookie-modal-actions"><button type="button" class="cf-cookie-outline" data-cf-cookie-action="essential">Only Essential</button><button type="submit">Save preferences</button></div>
    </form>
  </dialog>
</div>
<script src="{{ 'catalinas-cookie-banner.js' | asset_url }}" defer></script>
