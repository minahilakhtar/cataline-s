/* Flat-top cards and square hero frame: identical 20px corners at every size. */
#cf-home .image-frame { aspect-ratio:1/1!important; border-radius:20px!important; overflow:hidden; }
#cf-home .hero-video { border-radius:20px!important; width:100%; height:100%; object-fit:cover; }
#cf-home .hero-outline { border-radius:20px!important; }
#cf-home .category-accordion { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; min-height:0; }
#cf-home .category-panel, #cf-home .category-panel.active { border-radius:20px!important; height:clamp(340px,30vw,460px); min-width:0; overflow:hidden; }
#cf-home .category-panel>img { border-radius:20px!important; }
#cf-home .category-name { font-size:clamp(27px,2.6vw,40px); max-width:100%; }
#cf-home .category-detail { left:24px; right:24px; bottom:24px; }
#cf-home .category-select { padding-inline:24px; }
#cf-home .category-detail p { font-size:16px; line-height:1.5; }
#cf-home .category-explore { font-size:13px; padding:15px 16px; gap:8px; }
#cf-home .category-panel.active .category-name { transform:translateY(-135px)!important; }
@media(max-width:1100px) {
 #cf-home .category-accordion { grid-template-columns:repeat(2,minmax(0,1fr)); }
 #cf-home .category-panel,#cf-home .category-panel.active { height:400px; }
 #cf-home .category-name { font-size:38px; }
}
@media(max-width:620px) {
 #cf-home .category-accordion { grid-template-columns:1fr; gap:18px; }
 #cf-home .category-panel { height:190px; border-radius:20px!important; }
 #cf-home .category-panel.active { height:370px; border-radius:20px!important; }
 #cf-home .category-name { font-size:36px; }
 #cf-home .image-frame,#cf-home .hero-video,#cf-home .hero-outline { border-radius:20px!important; }
}
</style>
<style>
/* Product cutouts displayed inside a circular halo, matching the reference. */
#cf-home .ritual-display { min-height:550px; position:relative; overflow:visible; }
#cf-home .ritual-halo { width:420px; max-width:85%; aspect-ratio:1; border-radius:50%!important; top:30px; left:50%; transform:translateX(-50%); }
#cf-home .ritual-halo:after { border-radius:50%; inset:-22px; }
#cf-home .ritual-pack { position:absolute; top:85px; left:50%; width:78%; max-width:340px; height:265px!important; aspect-ratio:auto!important; object-fit:contain!important; object-position:center; border-radius:0!important; background:transparent!important; mix-blend-mode:normal; filter:drop-shadow(0 15px 13px #30492b20)!important; animation:cfRitualProductFloat 6s ease-in-out infinite!important; transform:translateX(-50%)!important; }
#cf-home .ritual-caption { position:absolute; top:370px; bottom:auto; left:0; width:100%; padding:0 12px; text-align:center; }
#cf-home .ritual-caption h3 { margin:0 0 12px; }
#cf-home .ritual-caption p { margin:0 auto 20px; max-width:430px; }
#cf-home .ritual-caption a { display:inline-block; text-decoration:none; padding-bottom:6px; border-bottom:1px solid currentColor; }
@media(max-width:850px) {
 #cf-home .ritual-display { min-height:520px; }
 #cf-home .ritual-halo { top:35px; }
 #cf-home .ritual-pack { top:95px; height:235px!important; }
 #cf-home .ritual-caption { top:350px; }
}
@media(max-width:620px) {
 #cf-home .ritual-display { min-height:520px; }
 #cf-home .ritual-halo { width:370px; max-width:86%; top:50px; }
 #cf-home .ritual-pack { top:100px; width:76%; max-width:300px; height:225px!important; }
 #cf-home .ritual-caption { top:345px; }
 #cf-home .ritual-caption h3 { font-size:29px; }
 #cf-home .ritual-tag { top:5px; }
}
</style>
<style>
/* Visible circle and motion, layered behind the transparent product. */
#cf-home .ritual-display { isolation:isolate; }
#cf-home .ritual-halo { display:block!important; visibility:visible!important; opacity:1!important; z-index:0!important; height:auto!important; aspect-ratio:1/1!important; border-radius:50%!important; background-color:#e7ebd5; pointer-events:none; }
#cf-home .ritual-halo::after { content:''!important; display:block!important; position:absolute; inset:-22px; border:1px dashed #07584438; border-radius:50%; animation:cfRitualRingSpin 55s linear infinite!important; }
#cf-home .ritual-pack { z-index:2; }
#cf-home .ritual-caption,#cf-home .ritual-tag,#cf-home .ritual-star,#cf-home .ritual-display>.botanical { z-index:3; }
@keyframes cfRitualProductFloat { 0%,100% { translate:0 0; rotate:-4deg; } 50% { translate:0 -14px; rotate:3deg; } }
@keyframes cfRitualRingSpin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
@media(prefers-reduced-motion:reduce) { #cf-home .ritual-pack,#cf-home .ritual-halo::after { animation:none!important; } }
#cf-home.motion-paused .ritual-pack,#cf-home.motion-paused .ritual-halo::after { animation-play-state:paused!important; }
</style>
<style>#cf-home .product-heading{padding-top:0}#cf-home .motion-toggle{z-index:60}</style>
<style>
/* Refined homepage: static wide film and lightweight editorial accents. */
#cf-home .hero{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,3vw,56px);min-height:0;padding-block:clamp(36px,5vw,76px)}
#cf-home .hero-copy{min-width:0}
#cf-home .hero-stage{width:100%;max-width:none;margin:0;padding:0;perspective:none;transform:none!important;translate:none!important;rotate:none!important;animation:none!important;transition:none!important}
#cf-home .hero-stage .image-frame,#cf-home .hero-stage:hover .image-frame{width:100%;max-height:none;aspect-ratio:6/5!important;border-radius:20px!important;box-shadow:none;transform:none!important;translate:none!important;rotate:none!important;animation:none!important;transition:none!important;will-change:auto}
#cf-home .hero-stage .hero-video,#cf-home .hero-stage:hover .hero-video{transform:none!important;translate:none!important;rotate:none!important;animation:none!important;transition:none!important;object-position:center;will-change:auto}
#cf-home .process-image:after{content:none!important;animation:none!important}
#cf-home .ritual-tag{max-width:92%;font-size:clamp(12px,1vw,15px);line-height:1.5;text-align:center;padding:13px 20px}
#cf-home .cf-care-note{position:relative;max-width:760px;margin:48px auto 0;padding:28px clamp(22px,4vw,48px) 24px;border:1px solid #07584426;border-radius:24px;background:linear-gradient(115deg,#f7f1e3,#fcfaf4);text-align:center;box-shadow:0 8px 24px #07584406}
#cf-home .cf-care-label{display:block;color:var(--green);font:600 10px/1.6 FarmSans,Arial,sans-serif;letter-spacing:.17em}
#cf-home .cf-care-note .benefit-feedback{margin:10px auto 0;min-height:0;max-width:640px;font-family:FarmItalic,Georgia,serif;font-size:clamp(22px,2vw,30px);line-height:1.45;color:var(--green);text-wrap:pretty}
#cf-home .cf-care-flourish{display:block;width:64px;height:3px;margin:18px auto 0;border-radius:50%;background:var(--gold);transform:rotate(-3deg)}
#cf-home .product-heading .cf-selection-note{display:inline-flex;flex-direction:column;align-items:flex-start;gap:6px;margin-top:24px;padding:15px 24px 17px 20px;border-left:3px solid var(--terra);border-radius:0 18px 18px 0;background:linear-gradient(100deg,#f7f1e3,#f7f1e370);color:var(--green)}
#cf-home .cf-note-kicker{font:600 10px/1.5 FarmSans,Arial,sans-serif;letter-spacing:.16em;color:#52644e}
#cf-home .cf-note-copy{font:400 clamp(20px,1.7vw,26px)/1.35 FarmSans,Arial,sans-serif;letter-spacing:-.035em}
#cf-home .cf-note-copy em{color:var(--terra);font-size:1.15em}
#cf-home .interaction-hint.cf-collection-note{display:inline-flex;align-items:center;gap:14px;max-width:100%;margin:0 0 26px;padding:10px 20px 10px 10px;border:1px solid #07584424;border-radius:18px;background:#f7f1e3;color:var(--green);font:500 clamp(14px,1.1vw,17px)/1.5 FarmSans,Arial,sans-serif}
#cf-home .cf-collection-note .cf-hint-mark{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:var(--green);color:#fff;font-size:23px}
#cf-home .cf-collection-note em{display:inline-block;color:var(--terra);font-size:1.22em}
@media(min-width:621px) and (max-width:1000px){#cf-home .hero{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:24px}#cf-home .hero h1{font-size:clamp(48px,7vw,76px)}#cf-home .hero-actions{flex-wrap:wrap;gap:20px}#cf-home .hero-stage .image-frame{aspect-ratio:4/5!important}}
@media(max-width:620px){#cf-home .hero{grid-template-columns:minmax(0,1fr);gap:32px;padding:36px 22px 48px}#cf-home .hero-stage{width:100%;max-width:none}#cf-home .hero-stage .image-frame{aspect-ratio:6/5!important}#cf-home .ritual-tag{left:0;right:0;margin-inline:auto;width:max-content;max-width:92%;rotate:-4deg}#cf-home .cf-care-note{margin-top:28px;padding:22px 18px;border-radius:20px}#cf-home .cf-care-label{font-size:9px;letter-spacing:.12em}#cf-home .product-heading .cf-selection-note{padding:12px 16px;margin-top:18px}#cf-home .interaction-hint.cf-collection-note{padding-right:14px;gap:10px}#cf-home .cf-collection-note em{display:block}}
</style>
<style>
/* Hero proportions and matching editorial labels. */
#cf-home .hero-stage .image-frame,#cf-home .hero-stage:hover .image-frame{aspect-ratio:7/5!important}
#cf-home .product-heading .cf-selection-note,#cf-home .interaction-hint.cf-collection-note{display:inline-flex;flex-direction:row;align-items:center;gap:0;max-width:100%;padding:14px 20px;border:1px solid #07584424;border-radius:18px;background:#f7f1e3;color:var(--green);box-shadow:none;font:500 clamp(14px,1.1vw,17px)/1.5 FarmSans,Arial,sans-serif}
#cf-home .product-heading .cf-selection-note{margin:24px 0 0}
#cf-home .interaction-hint.cf-collection-note{margin:0 0 26px}
#cf-home .cf-selection-note .cf-note-copy{font:inherit;letter-spacing:normal}
#cf-home .cf-selection-note .cf-note-copy em,#cf-home .cf-collection-note em{display:inline;color:var(--terra);font-size:1.22em}
@media(min-width:621px) and (max-width:1000px){#cf-home .hero-stage .image-frame,#cf-home .hero-stage:hover .image-frame{aspect-ratio:6/5!important}}
@media(max-width:620px){#cf-home .hero{gap:28px}#cf-home .hero-stage .image-frame,#cf-home .hero-stage:hover .image-frame{aspect-ratio:7/5!important}#cf-home .product-heading .cf-selection-note,#cf-home .interaction-hint.cf-collection-note{padding:12px 16px;border-radius:16px}#cf-home .product-heading .cf-selection-note{margin-top:18px}}
</style>
