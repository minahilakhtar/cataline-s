<link
  rel="stylesheet"
  href="{{ 'section-collection-showcase.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{{ 'component-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-carousel.js' | asset_url }}" defer="defer"></script>

{% render 'section-boundaries', section_id: section.id, section_settings: section.settings %}

{%- liquid
  assign blocks_to_display = section.blocks.size

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_tablet_int = section.settings.columns_tablet | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0

  assign image_width_int = section.settings.image_width | plus: 0
  assign image_height_int = section.settings.image_height | plus: 0

  assign enable_mobile_slider = false
  assign enable_tablet_slider = false
  assign enable_desktop_slider = false

  if section.settings.enable_mobile_slider and blocks_to_display > columns_mobile_int
    assign enable_mobile_slider = true
  endif

  if section.settings.enable_tablet_slider and blocks_to_display > columns_tablet_int
    assign enable_tablet_slider = true
  endif

  if section.settings.enable_desktop_slider and blocks_to_display > columns_desktop_int
    assign enable_desktop_slider = true
  endif

  assign has_any_slider = false
  if enable_mobile_slider or enable_tablet_slider or enable_desktop_slider
    assign has_any_slider = true
  endif
-%}

{%- style -%}
  .section#shopify-section-{{ section.id }} {
    margin: {{ section.settings.section_margin_all_sides }};
    padding: {{ section.settings.section_padding_all_sides }};
  }

  .collection-showcase-{{ section.id }} .collection-showcase__header {
    margin: {{ section.settings.header_margin }};
  }

    .collection-showcase-{{ section.id }} .collection-showcase__header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    }

    .collection-showcase-{{ section.id }} .collection-showcase__heading-wrap {
    flex: 1 1 auto;
    min-width: 0;
    }

    .collection-showcase-{{ section.id }} .collection-showcase__heading {
    color: {{ section.settings.heading_color }};
    font-weight: {{ section.settings.title_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    margin: 0;
    }

  .collection-showcase-{{ section.id }} .collection-showcase__heading {
    color: {{ section.settings.heading_color }};
    font-weight: {{ section.settings.title_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    margin: 0;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__controls {
    display: none;
    align-items: center;
    gap: {{ section.settings.arrow_gap }}px;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__controls.is-active {
    display: flex;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__slider-button {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    min-width: {{ section.settings.arrow_size }}px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.arrow_border_color }};
    background: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_icon_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: .2s ease-in-out;
    padding: 0;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__slider-button:hover,
  .collection-showcase-{{ section.id }} .collection-showcase__slider-button:focus {
    background: {{ section.settings.arrow_bg_hover_color }};
    border-color: {{ section.settings.arrow_border_hover_color }};
    color: {{ section.settings.arrow_icon_hover_color }};
  }

  .collection-showcase-{{ section.id }} .collection-showcase__slider-button[disabled] {
    opacity: .45;
    cursor: not-allowed;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__slider-button svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__slider {
    position: relative;
  }

  .collection-showcase-{{ section.id }} [data-slider-slide] {
    height: 100%;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__item {
    height: 100%;
    box-sizing: border-box;
    padding: {{ section.settings.list_padding }};
    margin: {{ section.settings.list_margin }};
    text-align: {{ section.settings.items_alignment }};
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.border_radius }}px;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__item.border {
    border: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    transition: .3s ease-in-out;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__item.border:hover {
    border-color: {{ section.settings.border_hover_color }};
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.12);
  }

  .collection-showcase-{{ section.id }} .collection-item {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.items_alignment }};
    justify-content: center;
    gap: 1rem;
    height: 100%;
  }

  .collection-showcase-{{ section.id }} .image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
   min-height: {{ image_height_int }}px;
  }

  .collection-showcase-{{ section.id }} .image-wrapper img,
  .collection-showcase-{{ section.id }} .image-wrapper svg {
    display: block;
    width: {{ image_width_int }}px;
    height: {{ image_height_int }}px;
    object-fit: contain;
  }

  .collection-showcase-{{ section.id }} .collection-title {
    color: {{ section.settings.title_color }};
    line-height: {{ section.settings.title_lineheight }};
    margin: 0;
  }

 @media screen and (max-width: 989px) {
  .collection-showcase-{{ section.id }} .collection-showcase__header-main {
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__heading {
    text-align: {{ section.settings.heading_alignment_mobile }};
  }

  .collection-showcase-{{ section.id }} .collection-item {
    align-items: center;
  }

  .collection-showcase-{{ section.id }} .collection-showcase__item {
    text-align: center;
  }
}
{%- endstyle -%}

<div
  class="collection-showcase-{{ section.id }} {{ section.settings.layout_type }}"
  data-carousel
  data-enable-mobile="{{ enable_mobile_slider }}"
  data-enable-tablet="{{ enable_tablet_slider }}"
  data-enable-desktop="{{ enable_desktop_slider }}"
  style="
    --columns-mobile: {{ columns_mobile_int }};
    --columns-tablet: {{ columns_tablet_int }};
    --columns-desktop: {{ columns_desktop_int }};
    --slider-gap: {{ section.settings.space_between }}px;
    --slider-arrow-gap: {{ section.settings.arrow_gap }}px;
  "
>
  {% if section.settings.heading != blank or has_any_slider %}
  <div class="collection-showcase__header">
    <div class="collection-showcase__header-main">
      <div class="collection-showcase__heading-wrap">
        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_size }} class="collection-showcase__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_size }}>
        {% endif %}
      </div>

      <div class="collection-showcase__controls" data-slider-controls>
        <button
          type="button"
          class="collection-showcase__slider-button"
          data-prev
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M9.5 3.5L5 8l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="collection-showcase__slider-button"
          data-next
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6.5 3.5L11 8l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
{% endif %}

  <div
    class="collection-showcase__slider"
    {% if has_any_slider %}
      data-autoplay="{{ section.settings.autoplay }}"
      data-speed="{{ section.settings.autoplay_speed }}"
      data-pause="{{ section.settings.pause_on_hover }}"
    {% endif %}
  >
    <div data-slider-track class="is-grid-mode">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}

        <div
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          class="freshcart-grid__item"
          data-slider-slide
          {{ block.shopify_attributes }}
        >
          <div class="collection-showcase__item{% if section.settings.show_border %} border{% endif %}">
            <a
              {% if collection and collection.url != blank %}
                href="{{ collection.url }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="collection-item"
            >
              <div class="image-wrapper">
                {%- if collection == blank -%}
                  {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {% assign unique_placeholder = 'collection-' | append: placeholder_image_index %}
                  {{ unique_placeholder | placeholder_svg_tag: 'placeholder-svg collection-card-placeholder-svg' }}
                {% else %}
                  {% if collection.image != blank %}
                    <img
                      src="{{ collection.image | image_url: width: image_width_int }}"
                      alt="{{ collection.title | escape }}"
                      loading="lazy"
                      width= {{ image_width_int }}
                      height= {{ image_height_int }}
                    >
                  {% elsif collection.products.first.featured_media != blank %}
                    <img
                      src="{{ collection.products.first.featured_media | image_url: width: image_width_int }}"
                      alt="{{ collection.title | escape }}"
                      loading="lazy"
                      width= {{ image_width_int }}
                      height= {{ image_height_int }}
                    >
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-card-placeholder-svg' }}
                  {% endif %}
                {%- endif -%}
              </div>
              <{{ section.settings.title_size }} class="collection-title">
                {% if collection != blank %}
                    {{ collection.title }}
                {% else %}
                    {{ 'sections.collection-card.onboarding.collection_title' | t }}
                {% endif %}
                </{{ section.settings.title_size }}>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-card.name",
  "tag": "section",
  "class": "section section-collection-showcase-card",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:sections.collection-card.settings.layout_type.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.collection-card.settings.layout_type.option__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.collection-card.settings.layout_type.option__2.label"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "t:sections.collection-card.settings.carousel_layout.content"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": false,
      "label": "t:sections.collection-card.settings.enable_desktop_slider.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.collection-card.settings.columns_desktop.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_tablet_slider",
      "default": false,
      "label": "t:sections.collection-card.settings.enable_tablet_slider.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:sections.collection-card.settings.columns_tablet.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "default": true,
      "label": "t:sections.collection-card.settings.enable_mobile_slider.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.collection-card.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-card.settings.columns_mobile.option__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-card.settings.columns_mobile.option__2.label"
        }
