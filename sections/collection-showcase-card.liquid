      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "t:sections.collection-card.settings.arrow_size.label",
      "default": 44
    },
    {
      "type": "range",
      "id": "arrow_gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "t:sections.collection-card.settings.arrow_gap.label",
      "default": 8
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "t:sections.collection-card.settings.arrow_bg_color.label",
      "default": "#eef1ef"
    },
    {
      "type": "color",
      "id": "arrow_bg_hover_color",
      "label": "t:sections.collection-card.settings.arrow_bg_hover_color.label",
      "default": "#dfe5e1"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "t:sections.collection-card.settings.arrow_icon_color.label",
      "default": "#7c8b8a"
    },
    {
      "type": "color",
      "id": "arrow_icon_hover_color",
      "label": "t:sections.collection-card.settings.arrow_icon_hover_color.label",
      "default": "#001e2b"
    },
    {
      "type": "color",
      "id": "arrow_border_color",
      "label": "t:sections.collection-card.settings.arrow_border_color.label",
      "default": "#eef1ef"
    },
    {
      "type": "color",
      "id": "arrow_border_hover_color",
      "label": "t:sections.collection-card.settings.arrow_border_hover_color.label",
      "default": "#dfe5e1"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
